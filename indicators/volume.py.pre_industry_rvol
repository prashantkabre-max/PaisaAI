def calculate_volume_metrics(candles, lookback=20):
    """
    PaisaAI Production RVOL Engine

    Uses completed candles for RVOL baseline.

    If the newest candle is still immature, RVOL is calculated
    using the last completed candle instead of the live candle.
    """

    empty = {
        "current_volume": 0,
        "average_volume": None,
        "rvol": None,
        "volume_spike": "UNKNOWN",
        "volume_trend": "UNKNOWN",
        "volume_strength": 0,
    }

    if not candles or len(candles) < 3:
        return empty

    # Live candle
    live = candles[-1]

    # Last completed candle
    completed = candles[-2]

    try:
        live_volume = float(live.get("volume", 0) or 0)
    except Exception:
        live_volume = 0.0

    try:
        completed_volume = float(completed.get("volume", 0) or 0)
    except Exception:
        completed_volume = 0.0

    # If live candle has accumulated less than 25% of the previous
    # completed candle's volume, treat it as immature.
    if completed_volume > 0 and live_volume < completed_volume * 0.25:
        current_volume = completed_volume
        baseline = candles[:-2][-lookback:]
    else:
        current_volume = live_volume
        baseline = candles[:-1][-lookback:]

    previous = []

    for candle in baseline:
        try:
            vol = float(candle.get("volume", 0) or 0)
        except Exception:
            continue

        if vol > 0:
            previous.append(vol)

    if not previous:
        return empty

    average = sum(previous) / len(previous)

    if average <= 0:
        return empty

    rvol = current_volume / average

    result = {
        "current_volume": current_volume,
        "average_volume": round(average, 2),
        "rvol": round(rvol, 2),
        "volume_spike": "LOW",
        "volume_trend": "STABLE",
        "volume_strength": 1,
    }

    if rvol >= 3:
        result["volume_spike"] = "EXTREME"
        result["volume_strength"] = 5
    elif rvol >= 2:
        result["volume_spike"] = "VERY_HIGH"
        result["volume_strength"] = 4
    elif rvol >= 1.5:
        result["volume_spike"] = "HIGH"
        result["volume_strength"] = 3
    elif rvol >= 1:
        result["volume_spike"] = "NORMAL"
        result["volume_strength"] = 2

    if len(previous) >= 10:
        recent = previous[-5:]
        older = previous[:-5]

        if older:
            recent_avg = sum(recent) / len(recent)
            older_avg = sum(older) / len(older)

            if recent_avg > older_avg * 1.10:
                result["volume_trend"] = "RISING"
            elif recent_avg < older_avg * 0.90:
                result["volume_trend"] = "FALLING"

    return result
